rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if caller is an authorized administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email in [
            'alfielynard23@gmail.com',
            'alfielynardrosalita@gmail.com',
            'dranyl23@gmail.com'
          ]
        )
      );
    }

    // User root document (Profile, Preferences & Telemetry)
    match /users/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // User Schedules subcollection
      match /schedules/{scheduleId} {
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // User Custom Profiles subcollection
      match /profiles/{profileId} {
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // User Notifications subcollection
      match /notifications/{notificationId} {
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // In-App User Feedback collection (Validated create, Admin read/update/delete)
    match /user_feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAny(['message', 'comment', 'rating']) &&
                       (!('message' in request.resource.data) || request.resource.data.message.size() <= 4000) &&
                       (!('comment' in request.resource.data) || request.resource.data.comment.size() <= 4000);
      allow read, update, delete: if isAdmin();
    }

    // Anonymous AI Training Telemetry Dataset collection (Validated create, Admin read/update/delete)
    match /ai_training_samples/{sampleId} {
      allow create: if request.resource.data.keys().hasAny(['verifiedEntries', 'entriesCount']) &&
                       request.resource.size() < 100000;
      allow read, update, delete: if isAdmin();
    }

    // Dynamic Institutions & Workplace Directory (Public Read, Admin Write Only)
    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Remote Broadcast Announcements & In-App Banners (Public Read, Admin Write Only)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Remote App Config & Feature Flags (Public Read, Admin Write Only)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6-Digit Class Block Schedule Sharing (Public Read & Validated Create for Classmates)
    match /shared_schedules/{shareCode} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['schedules']) &&
                       request.resource.data.schedules is list &&
                       request.resource.data.schedules.size() <= 50;
      allow update, delete: if isAdmin();
    }
  }
}
